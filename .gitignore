# Node / build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Versioned upload zips from `npm run package`
deploy/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# Claude Code local overrides: machine-specific, and this repo is PUBLIC.
# Do not rely on a personal global gitignore for this — only one machine has it.
.claude/settings.local.json

# Editor/OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Spike artifacts (large JARs are fetched, not committed)
spikes/**/*.jar
!spikes/**/gradle-wrapper.jar

# Gradle
.gradle/
spikes/**/build/
engine-java/build/
.playwright-mcp/
