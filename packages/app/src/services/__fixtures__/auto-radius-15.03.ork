<?xml version='1.0' encoding='utf-8'?>
<!--
  A minimal reduction of Frosty_Burrito's Comp_Rocket_V4.ork (The Rocketry
  Forum thread 170567, posted 2022-01), written by OpenRocket 15.03. The real
  file is 122 KB; the shape that matters is reproduced here at its own
  dimensions: a 6.17-inch nose cone with an explicit base radius followed by
  three body tubes whose radius is a BARE <radius>auto</radius>, then one tube
  that states the radius outright.

  Read with num()'s trailing-token parse the three bare autos became 12 mm
  tubes, which put CD @ M0.3 at 1.3550 instead of 0.4674 and cost 37 % of the
  apogee. The rings, the recovery Cd and the mass object below carry the other
  automatic shapes 15.03 could write, so a fix for the tubes cannot quietly
  change them.
-->
<openrocket version="1.6" creator="OpenRocket 15.03">
  <rocket>
    <name>Comp Rocket (reduced)</name>
    <motorconfiguration configid="a6bc1602-1556-4744-a271-203756818a10" default="true"/>
    <referencetype>maximum</referencetype>

    <subcomponents>
      <stage>
        <name>Primary Stage</name>

        <subcomponents>
          <nosecone>
            <name>Nose cone</name>
            <finish>normal</finish>
            <material type="bulk" density="2075.992848">Wildman G12</material>
            <length>0.78359</length>
            <thickness>0.002159</thickness>
            <shape>haack</shape>
            <shapeclipped>false</shapeclipped>
            <shapeparameter>0.0</shapeparameter>
            <aftradius>0.078359</aftradius>
            <aftshoulderradius>0.0</aftshoulderradius>
            <aftshoulderlength>0.0</aftshoulderlength>
            <aftshoulderthickness>0.0</aftshoulderthickness>
            <aftshouldercapped>false</aftshouldercapped>
          </nosecone>

          <bodytube>
            <name>Payload Tube</name>
            <finish>normal</finish>
            <material type="bulk" density="2075.992848">Wildman G12</material>
            <length>0.4699</length>
            <thickness>0.002159</thickness>
            <radius>auto</radius>
          </bodytube>

          <bodytube>
            <name>SwitchBand / Ebay Assembly</name>
            <finish>normal</finish>
            <material type="bulk" density="2075.992848">Wildman G12</material>
            <length>0.038099999999999995</length>
            <thickness>0.002159</thickness>
            <radius>auto</radius>
          </bodytube>

          <bodytube>
            <name>Recovery Tube</name>
            <finish>normal</finish>
            <material type="bulk" density="2075.992848">Wildman G12</material>
            <length>0.635</length>
            <thickness>0.002159</thickness>
            <radius>auto</radius>

            <subcomponents>
              <parachute>
                <name>Airframe Main</name>
                <position type="top">0.1</position>
                <packedlength>0.18</packedlength>
                <packedradius>0.05</packedradius>
                <material type="surface" density="0.06">Ripstop nylon</material>
                <diameter>2.4384</diameter>
                <cd>auto</cd>
                <linecount>8</linecount>
                <linelength>2.4384</linelength>
                <deployevent>ejection</deployevent>
                <deployaltitude>200.0</deployaltitude>
                <deploydelay>0.0</deploydelay>
              </parachute>
            </subcomponents>
          </bodytube>

          <bodytube>
            <name>Lower Body Tube</name>
            <finish>normal</finish>
            <material type="bulk" density="2075.992848">Wildman G12</material>
            <length>1.27</length>
            <thickness>0.002159</thickness>
            <radius>0.078359</radius>

            <subcomponents>
              <masscomponent>
                <name>Recovery Hardware</name>
                <position type="top">0.05</position>
                <packedlength>0.06</packedlength>
                <packedradius>auto</packedradius>
                <radialposition>0.0</radialposition>
                <radialdirection>0.0</radialdirection>
                <mass>0.2</mass>
                <masscomponenttype>recoveryhardware</masscomponenttype>
              </masscomponent>
              <centeringring>
                <name>Motor Ring</name>
                <position type="bottom">0.0</position>
                <material type="bulk" density="680.0">Cardboard</material>
                <length>0.00635</length>
                <radialposition>0.0</radialposition>
                <radialdirection>0.0</radialdirection>
                <outerradius>auto</outerradius>
                <innerradius>auto</innerradius>
              </centeringring>
              <trapezoidfinset>
                <name>Fins</name>
                <position type="bottom">0.0</position>
                <material type="bulk" density="2075.992848">Wildman G12</material>
                <fincount>3</fincount>
                <rotation>0.0</rotation>
                <thickness>0.00476</thickness>
                <crosssection>airfoil</crosssection>
                <cant>0.0</cant>
                <rootchord>0.3048</rootchord>
                <tipchord>0.127</tipchord>
                <sweeplength>0.1778</sweeplength>
                <height>0.1524</height>
              </trapezoidfinset>
            </subcomponents>
          </bodytube>
        </subcomponents>
      </stage>
    </subcomponents>
  </rocket>
</openrocket>
