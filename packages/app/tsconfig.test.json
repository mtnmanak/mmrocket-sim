{
  // The tests. They run under Node (vitest, some under happy-dom), read fixtures
  // with node:fs and hook `process`, so every @types package stays visible here —
  // exactly what the single project gave them before the split. The modules they
  // import are checked again in this program; that costs time, not correctness.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts"]
}
