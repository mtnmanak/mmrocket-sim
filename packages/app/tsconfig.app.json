{
  // The browser-shipped source. See tsconfig.json for why it is its own project.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // No automatic @types: @types/node is what let a Node-only global type-check
    // here. Library types still arrive through the imports that need them
    // (three, react), and src/vite-env.d.ts references vite/client explicitly.
    "types": [],
    // `obj.key` only for a declared property; a key from an index signature is
    // read `obj['key']`, which says in the source that it may be undefined — the
    // idiom the whole ComponentNode layer already writes. 0 errors in shipped
    // source (2026-09-22); the 11 in tests are why it is here, not in the base.
    "noPropertyAccessFromIndexSignature": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
