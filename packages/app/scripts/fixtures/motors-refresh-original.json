          "run: |",
          "mkdir -p \"$RUNNER_TEMP/refresh\"",
          "cp \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\" \\",
          "\"$RUNNER_TEMP/pr-body.md\" \"$RUNNER_TEMP/pr-title.txt\" \"$RUNNER_TEMP/commit-msg.txt\" \\",
          "\"$RUNNER_TEMP/refresh/\""
        ]
      },
      {
        "name": null,
        "run": null,
        "if": "steps.diff.outputs.open-pr == 'true'",
        "envKeys": [],
        "configuration": [
          "uses: actions/upload-artifact@<pin>",
          "if: steps.diff.outputs.open-pr == 'true'",
          "with:",
          "name: motors-refresh",
          "path: ${{ runner.temp }}/refresh",
          "if-no-files-found: error",
          "retention-days: 3"
        ]
