          "run: |",
          "if [ -f \"$RUNNER_TEMP/pr-body.md\" ]; then",
          "cat \"$RUNNER_TEMP/pr-body.md\" >> \"$GITHUB_STEP_SUMMARY\"",
          "fi"
        ]
      },
      {
        "name": "No motor changed — leave main alone",
        "run": [
          "echo \"Catalogue and curve bundle are unchanged apart from the date stamp.\"",
          "echo \"No pull request opened. The numbers are in the job summary.\""
        ],
        "if": "steps.diff.outputs.open-pr != 'true'",
        "envKeys": [],
        "configuration": [
          "name: No motor changed — leave main alone",
          "if: steps.diff.outputs.open-pr != 'true'",
          "run: |",
          "echo \"Catalogue and curve bundle are unchanged apart from the date stamp.\"",
          "echo \"No pull request opened. The numbers are in the job summary.\""
        ]
      },
      {
        "name": "Hand the refresh to the publish job",
        "run": [
          "mkdir -p \"$RUNNER_TEMP/refresh\"",
          "cp \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\" \\",
          "\"$RUNNER_TEMP/pr-body.md\" \"$RUNNER_TEMP/pr-title.txt\" \"$RUNNER_TEMP/commit-msg.txt\" \\",
          "\"$RUNNER_TEMP/refresh/\""
        ],
        "if": "steps.diff.outputs.open-pr == 'true'",
        "envKeys": [],
        "configuration": [
          "name: Hand the refresh to the publish job",
