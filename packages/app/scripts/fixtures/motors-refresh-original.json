        ]
      },
      {
        "name": null,
        "run": "npm ci",
        "if": null,
        "envKeys": [],
        "configuration": [
          "run: npm ci"
        ]
      },
      {
        "name": "Refresh the catalogue, the curve bundle and the user guide",
        "run": "npm run motors:refresh",
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: Refresh the catalogue, the curve bundle and the user guide",
          "run: npm run motors:refresh"
        ]
      },
      {
        "name": "Deploy gate on the refreshed data — typecheck",
        "run": "npm run typecheck",
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: Deploy gate on the refreshed data — typecheck",
          "run: npm run typecheck"
        ]
      },
      {
        "name": "Deploy gate on the refreshed data — lint, zero warnings",
        "run": "npm run lint -- --max-warnings 0",
