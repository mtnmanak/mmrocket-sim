      "env:",
      "DATA: packages/app/src/data"
    ],
    "permissions": [
      "contents: read"
    ],
    "steps": [
      {
        "name": null,
        "run": null,
        "if": null,
        "envKeys": [],
        "configuration": [
          "uses: actions/checkout@<pin>",
          "with:",
          "persist-credentials: false"
        ]
      },
      {
        "name": null,
        "run": null,
        "if": null,
        "envKeys": [],
        "configuration": [
          "uses: actions/setup-node@<pin>",
          "with:",
          "node-version: 22",
          "cache: npm"
        ]
      },
      {
        "name": "Keep the shipped catalogue to diff against",
        "run": [
