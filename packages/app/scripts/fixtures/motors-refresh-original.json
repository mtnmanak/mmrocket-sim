{
  "publish": {
    "header": [
      "needs: refresh",
      "if: needs.refresh.outputs.open-pr == 'true'",
      "runs-on: ubuntu-24.04",
      "timeout-minutes: 10",
      "permissions:",
      "contents: write",
      "pull-requests: write",
      "env:",
      "BRANCH: chore/motors-refresh",
      "DATA: packages/app/src/data"
    ],
    "permissions": [
      "contents: write",
      "pull-requests: write"
    ],
    "steps": [
      {
        "name": null,
        "run": null,
        "if": null,
        "envKeys": [],
        "configuration": [
          "uses: actions/checkout@<pin>",
          "with:",
          "persist-credentials: false"
        ]
      },
      {
        "name": null,
        "run": null,
        "if": null,
        "envKeys": [],
        "configuration": [
          "uses: actions/download-artifact@<pin>",
          "with:",
          "name: motors-refresh",
          "path: ${{ runner.temp }}/refresh"
        ]
      },
      {
        "name": "Commit onto the refresh branch",
        "run": [
          "cp \"$RUNNER_TEMP/refresh/motors.json\" \"$RUNNER_TEMP/refresh/motorCurves.json\" \\",
          "\"$RUNNER_TEMP/refresh/userGuide.ts\" \"$DATA/\"",
          "git config user.name 'github-actions[bot]'",
          "git config user.email '41898282+github-actions[bot]@users.noreply.github.com'",
          "git add -- \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\"",
          "git commit -F \"$RUNNER_TEMP/refresh/commit-msg.txt\"",
          "git push --force \\",
          "\"https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git\" \\",
          "\"HEAD:refs/heads/$BRANCH\""
        ],
        "if": null,
        "envKeys": [
          "GH_TOKEN"
        ],
        "configuration": [
          "name: Commit onto the refresh branch",
          "env:",
          "GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}",
          "run: |",
          "cp \"$RUNNER_TEMP/refresh/motors.json\" \"$RUNNER_TEMP/refresh/motorCurves.json\" \\",
          "\"$RUNNER_TEMP/refresh/userGuide.ts\" \"$DATA/\"",
          "git config user.name 'github-actions[bot]'",
          "git config user.email '41898282+github-actions[bot]@users.noreply.github.com'",
          "git add -- \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\"",
          "git commit -F \"$RUNNER_TEMP/refresh/commit-msg.txt\"",
          "git push --force \\",
          "\"https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git\" \\",
          "\"HEAD:refs/heads/$BRANCH\""
        ]
      },
      {
        "name": "Open or update the pull request",
        "run": [
          "n=$(gh pr list --head \"$BRANCH\" --state open --json number --jq '.[0].number // empty')",
          "if [ -z \"$n\" ]; then",
          "n=$(gh pr create --base main --head \"$BRANCH\" \\",
          "--title \"$(cat \"$RUNNER_TEMP/refresh/pr-title.txt\")\" \\",
          "--body-file \"$RUNNER_TEMP/refresh/pr-body.md\")",
          "echo \"opened $n\"",
          "else",
          "gh pr edit \"$n\" \\",
          "--title \"$(cat \"$RUNNER_TEMP/refresh/pr-title.txt\")\" \\",
          "--body-file \"$RUNNER_TEMP/refresh/pr-body.md\"",
          "echo \"updated existing PR",
          "fi",
          "gh pr edit \"$n\" --add-assignee mtnmanak || echo \"(could not assign; PR is open regardless)\""
        ],
        "if": null,
        "envKeys": [
          "GH_TOKEN"
        ],
        "configuration": [
          "name: Open or update the pull request",
          "env:",
          "GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}",
          "run: |",
          "n=$(gh pr list --head \"$BRANCH\" --state open --json number --jq '.[0].number // empty')",
          "if [ -z \"$n\" ]; then",
          "n=$(gh pr create --base main --head \"$BRANCH\" \\",
          "--title \"$(cat \"$RUNNER_TEMP/refresh/pr-title.txt\")\" \\",
          "--body-file \"$RUNNER_TEMP/refresh/pr-body.md\")",
          "echo \"opened $n\"",
          "else",
          "gh pr edit \"$n\" \\",
          "--title \"$(cat \"$RUNNER_TEMP/refresh/pr-title.txt\")\" \\",
          "--body-file \"$RUNNER_TEMP/refresh/pr-body.md\"",
          "echo \"updated existing PR",
          "fi",
          "gh pr edit \"$n\" --add-assignee mtnmanak || echo \"(could not assign; PR is open regardless)\""
        ]
      }
    ]
  },
