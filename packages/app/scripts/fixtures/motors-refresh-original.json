        "configuration": [
          "name: Deploy gate on the refreshed data — lint, zero warnings",
          "run: npm run lint -- --max-warnings 0"
        ]
      },
      {
        "name": "Deploy gate on the refreshed data — tests",
        "run": "npm test",
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: Deploy gate on the refreshed data — tests",
          "run: npm test"
        ]
      },
      {
        "name": "Deploy gate on the refreshed data — build",
        "run": "npm run build",
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: Deploy gate on the refreshed data — build",
          "run: npm run build"
        ]
      },
      {
        "name": "What git sees (informational only)",
        "run": "git diff --stat -- \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\"",
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: What git sees (informational only)",
          "run: git diff --stat -- \"$DATA/motors.json\" \"$DATA/motorCurves.json\" \"$DATA/userGuide.ts\""
        ]
      },
      {
        "name": "Summarise what actually changed",
        "run": [
          "node packages/app/scripts/motor-diff-summary.mjs \\",
          "--before \"$RUNNER_TEMP/before\" \\",
          "--after \"$DATA\" \\",
          "--markdown \"$RUNNER_TEMP/pr-body.md\" \\",
          "--title \"$RUNNER_TEMP/pr-title.txt\" \\",
          "--commit-message \"$RUNNER_TEMP/commit-msg.txt\" \\",
          "--github-output \"$GITHUB_OUTPUT\""
        ],
        "if": null,
        "envKeys": [],
        "configuration": [
          "name: Summarise what actually changed",
          "id: diff",
          "run: |",
          "node packages/app/scripts/motor-diff-summary.mjs \\",
          "--before \"$RUNNER_TEMP/before\" \\",
          "--after \"$DATA\" \\",
          "--markdown \"$RUNNER_TEMP/pr-body.md\" \\",
          "--title \"$RUNNER_TEMP/pr-title.txt\" \\",
